class Main {
    public static String dup(String str) //succeSsfulL 11
    {
        String result="";
        
        for(int i=0;i<str.length()-1;i++)
        {
            char c1=str.charAt(i); //2 5 9
            char c2=str.charAt(i+1); // 3  6 10
            String s1=""+c1;
            String s2=""+c2;
            if(s1.equalsIgnoreCase(s2))
            {
                i++;
            }
            else
            {
                result+=str.charAt(i);
            }
        }
        return result;
        
    }
    public static void main(String[] args) {
        System.out.println(dup("succeSsfuLl"));
    }
}
