import java.util.*;
class Main {
    public static void main(String[] args) {
        int[] arr={1,6,2,1,7,4,2,7,3,4,0,2,5,7,1,3,8,0,9};
        HashMap<Integer,Integer> fre=new HashMap<>();
        for(int i=0;i<arr.length;i++){
            if(fre.containsKey(arr[i])){
                fre.put(arr[i],fre.get(arr[i])+1);
            }
            else
            {
                fre.put(arr[i],1);
            }
        }
        
    }
}
