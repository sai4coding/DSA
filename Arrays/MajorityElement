package com.arrays;

public class MajorityElement {
    public static void main(String[] args) {
        int[] arr={7,0,1,7,7,2,7,7};
        int count=0;
        int element=arr[0];
        int max_count=0;
        for(int i=0;i<arr.length;i++){
            if(count==0){
                element=arr[i];
                count=1;
            }
            else if(arr[i]==element){
                count++;
            }
            else{
                count--;
            }
        }
        for(int i:arr){
            if(element==i){
                max_count++;
            }
        }
        if(max_count>arr.length/2){
            System.out.print(element +" is the Majority element");
        }
        else{
            System.out.print("No Majority element");
        }
    }
}
